# Create a bot with BotFather and paste its token here.
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN

# Numeric Telegram user IDs. At least one owner ID is required.
# Find your numeric ID using a trusted Telegram ID utility or an existing bot.
OWNER_IDS=123456789
# Optional additional panel users, comma-separated.
ADMIN_IDS=

# SQLite file. Keep this on persistent storage when deploying.
DATABASE_PATH=data/bot.db

# Polling and posting controls.
POLL_TIMEOUT=50
SEND_DELAY_SECONDS=0.10
DELETE_CHECK_INTERVAL=10
LOG_LEVEL=INFO
